# MQTT broker connection
MQTT_HOST=192.168.1.1
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASS=
# Base topic — state, availability, camera and command subtopics are appended
# MQTT_TOPIC=home/deadbolt

# Camera snapshot endpoint
CAMERA_URL=https://dafang/cgi-bin/currentpic.cgi

# Poll interval in seconds
# REFRESH_RATE=5

# Where the crop, setting overrides and reference images are stored
# CONFIG_DIR=/app/config
